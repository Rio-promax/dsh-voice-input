{
  "name": "dsh-plugin-voice-input",
  "version": "1.2.0",
  "description": "DSH voice input plugin: browser realtime + VAD dictation + local/cloud ASR + DeepSeek AI polish",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "python",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node scripts/prepack.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rio-promax/dsh-voice-input.git"
  },
  "homepage": "https://github.com/Rio-promax/dsh-voice-input#readme",
  "bugs": {
    "url": "https://github.com/Rio-promax/dsh-voice-input/issues"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "voice-input",
    "speech-to-text",
    "asr",
    "whisper",
    "funasr"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes"
      ],
      "immediately": false
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6"
  }
}
