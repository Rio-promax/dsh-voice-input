{
  "name": "dsh-plugin-voice-input",
  "version": "16.0.0",
  "description": "DSH voice input plugin: browser realtime + VAD dictation + local/cloud ASR + DeepSeek AI polish",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes"
      ],
      "immediately": false
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6"
  }
}
